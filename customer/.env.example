# NIVA Customer App — Environment template. Copy to `.env` and fill in.
# Only PUBLIC values belong here. Never add the Supabase service key.
EXPO_PUBLIC_API_URL=https://niva-backend.vercel.app
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
EXPO_PUBLIC_APP_TYPE=customer
